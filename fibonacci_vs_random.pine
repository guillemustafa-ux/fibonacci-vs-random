//@version=6
indicator("Fibonacci vs Random Ratios: Where Pullbacks Actually Stop", shorttitle = "FIB-VS-RANDOM", overlay = true, behind_chart = false, max_labels_count = 100)

// Fibonacci vs Random Ratios
// 1) Finds swings with ta.pivothigh and ta.pivotlow over one pivot length and keeps them alternating: a pivot
//    of the same type as the last kept one replaces it when it is more extreme and is ignored otherwise. Every
//    kept pivot after the second ends a pullback: the two before it define the leg, the new one is where the
//    pullback stopped, and depth = pullback / leg. A depth of 1 or more is a full retrace and leaves the test.
// 2) A pullback is a Fibonacci hit when its depth lies within a tolerance of one of the enabled levels (0.236,
//    0.382, 0.5, 0.618, 0.786). The same test runs against K sets of as many ratios each, drawn once in
//    [0.2, 0.8] by a seeded generator, so the sets are the same on every bar and on every chart.
// 3) On the last bar the table shows the Fibonacci hit rate with a 95% confidence interval, the mean, lowest
//    and highest rate of the random sets, how many random sets did as well as the levels or better, and the
//    distribution of depths. When many random sets do as well, the levels are not special on this chart.
// The result is a table of counts for this symbol on this chart, not a rule.

// ───────────────────────── Inputs ─────────────────────────
len = input.int(10, "Pivot length", minval = 2, group = "Swings", tooltip = "Bars on each side that a pivot high or low must exceed. A pivot confirms this many bars after its bar, and its price is the high or low of that bar. Every number in the table depends on it.")

tol = input.float(0.02, "Tolerance", minval = 0.005, maxval = 0.1, step = 0.005, group = "Levels", tooltip = "A pullback is a hit when |depth - ratio| <= tolerance. The same tolerance applies to the Fibonacci levels and to the random ratios.")
use236 = input.bool(true, "0.236", group = "Levels", inline = "levels")
use382 = input.bool(true, "0.382", group = "Levels", inline = "levels")
use500 = input.bool(true, "0.5", group = "Levels", inline = "levels")
use618 = input.bool(true, "0.618", group = "Levels", inline = "levels")
use786 = input.bool(true, "0.786", group = "Levels", inline = "levels")

numSets = input.int(20, "Random sets K", minval = 5, maxval = 50, group = "Random baseline", tooltip = "Sets of random ratios the pullbacks are tested against. Each set has as many ratios as there are enabled levels, each ratio uniform in [0.2, 0.8].")
seed = input.int(7, "Seed", minval = 0, maxval = 2147483647, group = "Random baseline", tooltip = "Seed of the generator that draws the random ratios. The same seed gives the same ratios on every chart; change it to draw other sets.")

labelN = input.int(30, "Label the last N pullbacks", minval = 0, maxval = 100, group = "Display", tooltip = "A label at the pivot where each of the last N pullbacks stopped, with its depth; F marks a Fibonacci hit. 0 draws none.")
tablePos = input.string("Bottom right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = "Display")
textSize = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal"], group = "Display")

// ───────────────────────── Levels and random ratios ─────────────────────────
// The enabled levels, in order, and their text for the header; built once.
var array<float> fibLevels = array.new<float>()
var string levelsTxt = ""
if barstate.isfirst
    if use236
        array.push(fibLevels, 0.236)
    if use382
        array.push(fibLevels, 0.382)
    if use500
        array.push(fibLevels, 0.5)
    if use618
        array.push(fibLevels, 0.618)
    if use786
        array.push(fibLevels, 0.786)
    for lv in fibLevels
        levelsTxt += (levelsTxt == "" ? "" : " ") + str.tostring(lv, "0.###")
    if levelsTxt == ""
        levelsTxt := "none"
int numLevels = array.size(fibLevels)

// K sets of numLevels ratios each, uniform in [0.2, 0.8], from the linear congruential generator
// state = (1103515245 * state + 12345) % 2^31 seeded by the input, so the same seed gives the same sets on
// every chart. The product is taken in two parts that each stay below 2^53, so it is exact whatever the width
// of the int: 1103515245 = 16838 * 65536 + 20077. Flattened: ratio j of set k is at k * numLevels + j. The
// per-set hit counts live beside them. The loops are guarded: with no level enabled there is nothing to draw,
// and a for loop whose end is below its start would count down.
var array<float> randRatios = array.new<float>()
var array<int> randHits = array.new<int>()
if barstate.isfirst
    int state = seed
    if numLevels > 0
        for i = 0 to numSets * numLevels - 1
            int hi = (16838 * state) % 32768
            state := (hi * 65536 + 20077 * state + 12345) % 2147483648
            array.push(randRatios, 0.2 + 0.6 * state / 2147483648)
    for k = 0 to numSets - 1
        array.push(randHits, 0)

// ───────────────────────── Swings ─────────────────────────
// A pivot confirms len bars after its bar: its price is high[len] or low[len], its bar is bar_index - len.
float ph = ta.pivothigh(high, len, len)
float pl = ta.pivotlow(low, len, len)

// The last three kept pivots, oldest first: type (1 high, -1 low), price and bar index.
var array<int> pivType = array.new<int>()
var array<float> pivPrice = array.new<float>()
var array<int> pivBar = array.new<int>()

// Adds a confirmed pivot to the kept pivots and returns true when it was appended. Same type as the last kept
// pivot: it replaces that pivot when it is more extreme (higher high, lower low), is ignored otherwise, and
// no pullback ends. Opposite type: it is appended and the oldest beyond three is dropped.
addPivot(int typ, float price, int bar) =>
    int n = array.size(pivType)
    bool appended = false
    if n > 0 and array.get(pivType, n - 1) == typ
        float last = array.get(pivPrice, n - 1)
        if (typ == 1 and price > last) or (typ == -1 and price < last)
            array.set(pivPrice, n - 1, price)
            array.set(pivBar, n - 1, bar)
    else
        array.push(pivType, typ)
        array.push(pivPrice, price)
        array.push(pivBar, bar)
        if array.size(pivType) > 3
            array.shift(pivType)
            array.shift(pivPrice)
            array.shift(pivBar)
        appended := true
    appended

// True when |d - r| <= tol for one ratio r of arr at the positions first to stop - 1.
hitAny(array<float> arr, int first, int stop, float d) =>
    bool hit = false
    if stop > first
        for i = first to stop - 1
            if math.abs(d - array.get(arr, i)) <= tol
                hit := true
                break
    hit

// ───────────────────────── Ledger state ─────────────────────────
// Bars counted, pullbacks (depth in (0, 1)), full retraces (depth >= 1), Fibonacci hits, the depth bins
// 0-0.2 to 0.8-1, the last pullback, and the labels of the last N pullbacks, oldest first.
var int nBars = 0
var int pullbacks = 0
var int fullRetraces = 0
var int fibHits = 0
var array<int> depthBins = array.new<int>(5, 0)
var float lastDepth = float(na)
var bool lastFibHit = false
var int lastTime = int(na)
var array<label> labels = array.new<label>()

color fibCol = color.new(color.orange, 0)
color otherCol = color.new(color.gray, 20)

// ───────────────────────── Ledger update ─────────────────────────
// A pivot confirms on the bar len bars after its own, which is a closed bar; on the realtime bar ta.pivothigh
// and ta.pivotlow still read that bar's forming high and low, so counting waits for the bar to confirm and no
// count changes after a bar has closed. A bar can confirm a pivot high and a pivot low at once, when the bar
// len bars back is the extreme on both sides: the high is taken first, then the low, as in the simulation.
if barstate.isconfirmed
    nBars += 1
    for side = 0 to 1
        int typ = side == 0 ? 1 : -1
        float pv = typ == 1 ? ph : pl
        if not na(pv)
            if addPivot(typ, pv, bar_index - len) and array.size(pivType) == 3
                // The leg runs from the first kept pivot to the second, the pullback from the second to the new
                // one. Up leg (low, high, low): leg = high - first low, pullback = high - new low. Down leg
                // (high, low, high): leg = first high - low, pullback = new high - low.
                bool upLeg = array.get(pivType, 0) == -1
                float p0 = array.get(pivPrice, 0)
                float p1 = array.get(pivPrice, 1)
                float p2 = array.get(pivPrice, 2)
                float leg = upLeg ? p1 - p0 : p0 - p1
                float pull = upLeg ? p1 - p2 : p2 - p1
                // A leg of zero or negative height (the second pivot did not get past the first) is skipped,
                // and so is a pullback that did not come back at all (depth <= 0). A depth of 1 or more took
                // the whole leg back: a full retrace, counted but kept out of the hit test.
                if leg > 0
                    float depth = pull / leg
                    if depth >= 1
                        fullRetraces += 1
                    else if depth > 0
                        pullbacks += 1
                        bool fib = hitAny(fibLevels, 0, numLevels, depth)
                        if fib
                            fibHits += 1
                        for k = 0 to numSets - 1
                            if hitAny(randRatios, k * numLevels, (k + 1) * numLevels, depth)
                                array.set(randHits, k, array.get(randHits, k) + 1)
                        int bin = math.min(math.floor(depth * 5), 4)
                        array.set(depthBins, bin, array.get(depthBins, bin) + 1)
                        lastDepth := depth
                        lastFibHit := fib
                        lastTime := time[len]
                        // One label at the pivot that ended the pullback; the oldest beyond N is deleted, so
                        // there are never more than N, and N is at most 100.
                        if labelN > 0
                            label lb = label.new(bar_index - len, p2, str.tostring(depth, "0.00") + (fib ? " F" : ""), style = upLeg ? label.style_label_up : label.style_label_down, color = fib ? fibCol : otherCol, textcolor = color.white, size = size.small)
                            array.push(labels, lb)
                            while array.size(labels) > labelN
                                label.delete(array.shift(labels))

// ───────────────────────── Table ─────────────────────────
tPos = switch tablePos
    "Top right" => position.top_right
    "Bottom right" => position.bottom_right
    "Top left" => position.top_left
    => position.bottom_left

tSize = switch textSize
    "Tiny" => size.tiny
    "Normal" => size.normal
    => size.small

// Four columns: the measure names and up to three values. Nine rows: header, seven measures, footer.
var table tbl = table.new(tPos, 4, 9, border_width = 1)

// Opaque cell colors blended from the chart background, so candles do not show through the table
// on a light or a dark theme.
cellBg = color.from_gradient(0.12, 0.0, 1.0, chart.bg_color, color.gray)
hdrBg = color.from_gradient(0.30, 0.0, 1.0, chart.bg_color, color.gray)
goodBg = color.from_gradient(0.40, 0.0, 1.0, chart.bg_color, color.green)

setCell(int col, int row, string txt, color bg = na, string align = text.align_center) =>
    table.cell(tbl, col, row, txt, text_color = chart.fg_color, text_size = tSize, text_halign = align, bgcolor = na(bg) ? cellBg : bg)

// "12.3%" from a rate in [0, 1], "n/a" when there is none.
fmtRate(float r) =>
    na(r) ? "n/a" : str.tostring(r * 100, "0.0") + "%"

// "45.2%" from a count and a total, "n/a" when the total is zero.
fmtShare(int n, int total) =>
    total > 0 ? str.tostring(float(n) / total * 100.0, "0.0") + "%" : "n/a"

// "+1.2 pts" or "-1.2 pts" from a signed difference in percentage points, "n/a" when there is none.
fmtPts(float v) =>
    na(v) ? "n/a" : (v > 0 ? "+" : "") + str.tostring(v, "0.0") + " pts"

// "0.62" from a depth, "n/a" when there is none.
fmtDepth(float d) =>
    na(d) ? "n/a" : str.tostring(d, "0.00")

// The bar's open time in the chart symbol's exchange time, "n/a" when there is none.
fmtTime(int t) =>
    na(t) ? "n/a" : str.format_time(t, "yyyy-MM-dd HH:mm", syminfo.timezone)

// Merged rows are merged once: merging cells that are already merged on every realtime tick is avoided.
var bool merged = false

if barstate.islast
    if numLevels == 0
        setCell(0, 0, "Enable at least one Fibonacci level", hdrBg, text.align_left)
    else
        int n = pullbacks
        // Fibonacci rate and its 95% confidence interval, rate +- 1.96 * sqrt(rate * (1 - rate) / n), clipped
        // to [0, 1] for the display.
        float fibRate = n > 0 ? float(fibHits) / n : float(na)
        float ciHalf = n > 0 ? 1.96 * math.sqrt(fibRate * (1 - fibRate) / n) : float(na)
        string ciTxt = n > 0 ? fmtRate(math.max(fibRate - ciHalf, 0)) + " - " + fmtRate(math.min(fibRate + ciHalf, 1)) : "n/a"
        // Random sets: mean, lowest and highest rate, and how many did as well as the levels or better. The
        // comparison is on hit counts, which share the same n, so a tie counts as "as well".
        float sumRate = 0.0
        float minRate = float(na)
        float maxRate = float(na)
        int setsGe = 0
        for k = 0 to numSets - 1
            int h = array.get(randHits, k)
            float r = n > 0 ? float(h) / n : float(na)
            sumRate += nz(r)
            if na(minRate) or r < minRate
                minRate := r
            if na(maxRate) or r > maxRate
                maxRate := r
            if n > 0 and h >= fibHits
                setsGe += 1
        float meanRate = n > 0 ? sumRate / numSets : float(na)
        float shareGe = float(setsGe) / numSets
        // Verdict from the share of random sets that did as well as the levels or better: one in ten or more,
        // the levels are not special here; under one in twenty, the levels are ahead; between, borderline.
        string verdict = n == 0 ? "no pullbacks yet" : shareGe >= 0.1 ? "fib not special" : shareGe < 0.05 ? "fib ahead" : "borderline"
        if n > 0 and n < 30
            verdict += " (small sample)"
        // What a depth spread evenly over [0.2, 0.8] would give: each ratio catches 2 * tol of that 0.6 range;
        // overlapping windows make the true figure a little smaller. Capped at 100%.
        float uniformRef = math.min(numLevels * 2 * tol / 0.6, 1.0)
        // ticker.standard gives the plain "prefix:ticker" form; syminfo.tickerid can carry the session,
        // adjustment and currency modifiers in an encoded form.
        setCell(0, 0, ticker.standard(syminfo.tickerid) + " · " + timeframe.period + " · pivot length " + str.tostring(len) + " · tolerance " + str.tostring(tol, "0.000") + " · levels on " + levelsTxt, hdrBg, text.align_left)
        setCell(0, 1, "Pullbacks", na, text.align_left)
        setCell(1, 1, str.tostring(n, "#,##0") + " pullbacks")
        setCell(2, 1, str.tostring(fullRetraces, "#,##0") + " full retraces")
        setCell(3, 1, str.tostring(nBars, "#,##0") + " bars counted")
        setCell(0, 2, "Fib hits", na, text.align_left)
        setCell(1, 2, str.tostring(fibHits, "#,##0") + " hits")
        setCell(2, 2, "rate " + fmtRate(fibRate))
        setCell(3, 2, "95% CI " + ciTxt)
        setCell(0, 3, "Random ratios", na, text.align_left)
        setCell(1, 3, str.tostring(numSets) + " sets · " + str.tostring(numLevels) + " ratios each")
        setCell(2, 3, "mean rate " + fmtRate(meanRate))
        setCell(3, 3, "min " + fmtRate(minRate) + " · max " + fmtRate(maxRate))
        // Green only when the levels are ahead of the random sets; the other verdicts are plain.
        setCell(0, 4, "Random sets >= fib", na, text.align_left)
        setCell(1, 4, str.tostring(setsGe) + " of " + str.tostring(numSets))
        setCell(2, 4, verdict, n > 0 and shareGe < 0.05 ? goodBg : na)
        setCell(3, 4, "")
        setCell(0, 5, "Difference", na, text.align_left)
        setCell(1, 5, "fib - random mean " + fmtPts(n > 0 ? (fibRate - meanRate) * 100 : float(na)))
        setCell(2, 5, "uniform reference " + fmtRate(uniformRef))
        setCell(3, 5, "")
        setCell(0, 6, "Depth distribution", na, text.align_left)
        setCell(1, 6, "0-0.2 " + fmtShare(array.get(depthBins, 0), n) + " · 0.2-0.4 " + fmtShare(array.get(depthBins, 1), n))
        setCell(2, 6, "0.4-0.6 " + fmtShare(array.get(depthBins, 2), n) + " · 0.6-0.8 " + fmtShare(array.get(depthBins, 3), n))
        setCell(3, 6, "0.8-1 " + fmtShare(array.get(depthBins, 4), n))
        setCell(0, 7, "Last pullback", na, text.align_left)
        setCell(1, 7, "depth " + fmtDepth(lastDepth))
        setCell(2, 7, "fib hit " + (na(lastDepth) ? "n/a" : lastFibHit ? "yes" : "no"))
        setCell(3, 7, "bar " + fmtTime(lastTime))
        setCell(0, 8, "Counts on confirmed pivots. Not advice. Dates in the chart symbol's exchange time · " + syminfo.timezone, hdrBg, text.align_left)
        for c = 1 to 3
            setCell(c, 0, "", hdrBg)
            setCell(c, 8, "", hdrBg)
        if not merged
            table.merge_cells(tbl, 0, 0, 3, 0)
            table.merge_cells(tbl, 0, 8, 3, 8)
            merged := true
